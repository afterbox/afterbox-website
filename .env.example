# Copy to .env.local and fill in.

# The API (local http://localhost:8000, production https://api.afterbox.co.uk).
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostHog: set the key on Vercel's production environment only. With no key, nothing is sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
