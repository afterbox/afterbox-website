# Copy to .env.local and fill in.

# Tink Link. The client ID is public (it ends up in the browser and in the Tink URL).
# The Tink client secret is server-only: never put it in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TINK_CLIENT_ID=

# Optional. Where Tink sends people back to, without a trailing slash.
# Leave unset to use the site's own origin (http://localhost:3000 locally, https://afterbox.co.uk in production).
# NEXT_PUBLIC_TINK_REDIRECT_ORIGIN=https://afterbox.co.uk
